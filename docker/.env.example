# looky — Docker Compose production deployment
# Copy to .env and fill in values
#
# Usage: docker compose --env-file .env -f docker-compose.yml up -d

# --- Required (host bind paths; compose refuses to start if unset) ---
IMAGE_TAG=
STATIC_ASSET_VERSION=
POSTGRES_DATA_PATH=
WORKSPACES_PATH=
# VALIDATION_STAGING_PATH — host dir for the validate staging tree, bind-
# mounted into /workspaces/.validation-staging for app + query-engine.
# MUST be a SEPARATE dir OUTSIDE WORKSPACES_PATH (a sibling, not nested),
# or staging lands physically inside the real workspaces and anything
# watching WORKSPACES_PATH (e.g. the n8n PDF janitor) sees it.
# Pre-create BOTH this dir AND the (empty) mount point inside WORKSPACES_PATH
# before first ``up`` — the read-only query-engine cannot create the mount
# point itself, so the stack fails to start without it:
#   mkdir -p "$VALIDATION_STAGING_PATH" "$WORKSPACES_PATH/.validation-staging"
# Never ``rm`` the mount point while the stack is up — it detaches the bind
# mount and staging starts writing nested again. Stop the stack first.
VALIDATION_STAGING_PATH=
# VAULT_DATA_PATH must exist AND be owned by 65532:65532 before first
# ``up``. The secrets-vault container runs distroless as uid 65532 and
# cannot chown its own mount, so a root-owned dir (the default when
# Docker auto-creates a bind mount) makes every PUT fail with EACCES.
#   mkdir -p /path/to/vault-data && sudo chown 65532:65532 /path/to/vault-data
VAULT_DATA_PATH=
# LOOKY_DOCS_BASE_URL — the public docs site the agent chat authors against
# (llms.txt + per-page .md live under it). Required, no default: the app
# refuses to boot without it. For looky.studio deployments:
#   LOOKY_DOCS_BASE_URL=https://looky.studio
LOOKY_DOCS_BASE_URL=

# --- LOOKY_DB (Postgres: auth + workspace content) ---
LOOKY_DB_NAME=looky
LOOKY_DB_USER=looky
LOOKY_DB_PASSWORD=looky
LOOKY_DB_URL=postgresql://looky:looky@postgres:5432/looky

# --- Auth & Session ---
LOOKY_SESSION_SECRET=
# Session cookie hardening. Secure MUST stay true in production (cookie sent
# over HTTPS only). Leave SameSite=Lax unless the login flow needs cross-site
# deep links; Strict is stronger against CSRF. Defaults applied in compose
# (Secure=true, SameSite=Lax) if left blank here.
LOOKY_SESSION_COOKIE_SECURE=true
LOOKY_SESSION_COOKIE_SAMESITE=Lax
LOOKY_AUTH_SESSION_MINUTES_USER=
LOOKY_AUTH_SESSION_MINUTES_SUPER_ADMIN=
EXPORT_ENGINE_SHARED_TOKEN=

# Invitation token encryption (Fernet). For production generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVITATION_TOKEN_ENCRYPTION_KEY=

# --- Secrets vault (Ed25519 keypair, per-deploy) ---
# Vault holds ``runtime/sources.runtime.yml`` + ``secrets/*.json`` for
# every workspace. The Flask app signs workspace-scoped tokens with
# the private key; the vault container verifies them with the public
# key. Generate ONCE per deploy (NOT per restart) with:
#
#   docker run --rm node:20-slim node -e "
#     const c = require('crypto');
#     const { publicKey, privateKey } = c.generateKeyPairSync('ed25519');
#     const priv = privateKey.export({ format: 'pem', type: 'pkcs8' });
#     const pub  = publicKey.export({ format: 'pem', type: 'spki' });
#     console.log('LOOKY_VAULT_SIGNING_PRIVATE_KEY=' + Buffer.from(priv).toString('base64'));
#     console.log('LOOKY_VAULT_VERIFY_PUBLIC_KEY=' + Buffer.from(pub).toString('base64'));
#   "
#
# Paste both lines below. Token TTL defaults to 300s (5 min);
# set ``LOOKY_VAULT_TOKEN_TTL_SECONDS`` only to override.
LOOKY_VAULT_SIGNING_PRIVATE_KEY=
LOOKY_VAULT_VERIFY_PUBLIC_KEY=
# LOOKY_VAULT_TOKEN_TTL_SECONDS=300

# --- Stytch (auth, email OTP, required) ---
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_ENV=test
STYTCH_PROJECT_TYPE=b2b
STYTCH_ORGANIZATION_ID=

# --- Optional ---
COMPOSE_PROJECT_NAME=looky
DEFAULT_WORKSPACE_ID=
WORKSPACE_CONTENT_WATCHER_DEBOUNCE_MS=500
# Public base URL used to build links in transactional emails (invitations).
# REQUIRED in prod: the settings.py default points at localhost, so invite
# links break unless you set the real public URL here.
PUBLIC_APP_BASE_URL=https://my.looky.studio

# --- Default KV (Redis-backed; queues, caches, status keys) ---
# Authoritative defaults live in ``looky/app/src/settings.py`` and
# ``looky/export-engine/export_engine/config.py``. Compose passes
# the var through unchanged. Set here ONLY to override.
# DEFAULT_KV_URL=redis://redis:6379/0

# --- Messaging (RabbitMQ) ---
# Empty by default — messaging is OFF in prod until you point it at
# a broker. When you wire one up, set DEFAULT_MESSAGING_URL and the
# corresponding rabbitmq network in the compose file. The bq-stats
# telemetry publisher only emits when both vars are set.
# DEFAULT_MESSAGING_URL=amqp://looky:<password>@rabbitmq:5672/looky
# BQ_JOBS_STATS_EXCHANGE=bq-jobs-stats
# TRANSACTIONAL_EMAILS_EXCHANGE=transactional-emails

# --- Structured logging ---
# Floor for the JSON log formatter installed by ``setup_logging`` in
# every component (see SPEC_CENTRALIZED_LOGGING.md). Default INFO.
# DEBUG is noisy — useful when chasing a specific incident, expensive
# at steady state.
LOG_LEVEL=INFO

# --- Async validation queue (server-side `looky validate` / `looky push`) ---
# Defaults are sensible; override only if you have a reason.
# VALIDATION_JOB_TTL_MINUTES=30        # how long a job's state lives in Redis
# VALIDATION_JOB_MAX_WORKERS=4         # threads in the dispatcher pool
# VALIDATION_MAX_CONCURRENCY=4         # parallel compile/dry-run per job
# VALIDATION_STAGING_TTL_MINUTES=30    # janitor sweep age for abandoned staging dirs

# --- Port overrides (defaults: 8000, 55432, 3002, 6379) ---
# BACKEND_HOST_PORT=8000
# LOOKY_DB_HOST_PORT=55432
# MALLOY_SERVICE_HOST_PORT=3002
# DEFAULT_KV_HOST_PORT=6379
